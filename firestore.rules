rules_version = '2';

/**
 * NESREEN MAGAZINE — Firestore təhlükəsizlik qaydaları
 *
 * Dizayn və proqramlaşdırma: Cradex Agency · https://cradexagency.com
 *
 * Firebase konsolunda: Firestore Database → Rules → bu mətni yapışdırıb Publish.
 *
 * Məntiq:
 *   • Oxucu yalnız dərc olunmuş məqalələri, bürc şərhlərini və aktiv bannerləri görür.
 *   • Yazmaq üçün redaksiya heyətində olmaq lazımdır (staff sənədi + active: true).
 *   • İşçiləri idarə etmək, silmək və banner qoymaq yalnız adminə açıqdır.
 *   • Abunəlik və əlaqə formaları hər kəsə yazmağa açıqdır, amma oxumağa yox.
 *   • CRM, audit, bildirişlər yalnız staff-a açıqdır.
 *   • Audit qeydləri və versiyalar dəyişdirilə/silinə bilməz — immutable.
 *
 * Kolleksiyalar:
 *   articles, horoscopes, banners, ebookBanners, ejournals,
 *   staff, subscribers, messages,
 *   crmClients, crmActivities, adOrders, contentPlan,
 *   seoRedirects, seoSettings, siteSettings,
 *   auditLogs, notifications, articleVersions
 */

service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════
    //  Köməkçi funksiyalar
    // ═══════════════════════════════════════════

    /** İstifadəçi daxil olub? */
    function signedIn() {
      return request.auth != null;
    }

    /** İşçi sənədinin ID-si — e-poçt kiçik hərflə. */
    function staffId() {
      return request.auth.token.email.lower();
    }

    /** Cari istifadəçinin staff sənədi. */
    function staffDoc() {
      return get(/databases/$(database)/documents/staff/$(staffId()));
    }

    /**
     * Aktiv staff üzvüdürmü?
     * 1) Daxil olub
     * 2) E-poçt var
     * 3) staff kolleksiyasında mövcuddur
     * 4) active == true
     */
    function isStaff() {
      // email_verified: başqasının e-poçtu ilə qeydiyyatdan keçən şəxs (poçt qutusuna
      // girişi olmadan) staff icazəsi ala bilməsin
      return signedIn()
          && request.auth.token.email != null
          && request.auth.token.email_verified == true
          && exists(/databases/$(database)/documents/staff/$(staffId()))
          && staffDoc().data.active == true;
    }

    /** Admin rolumdamı? */
    function isAdmin() {
      return isStaff() && staffDoc().data.role == 'admin';
    }

    /**
     * Məqalə yazma icazəsi:
     *  • admin — bütün kateqoriyalarda
     *  • editor / author — yalnız staff sənədindəki categories siyahısında olan
     *    kateqoriyalarda (siyahı boşdursa, bütün kateqoriyalar açıqdır)
     */
    function canWriteArticle(category) {
      return isAdmin() || (
        isStaff()
        && staffDoc().data.role in ['editor', 'author']
        && (
          !('categories' in staffDoc().data)
          || staffDoc().data.categories.size() == 0
          || category in staffDoc().data.categories
        )
      );
    }

    /** Satış/CRM-ə icazəsi varmı? (admin, sales, finance) */
    function canAccessCrm() {
      return isStaff() && staffDoc().data.role in ['admin', 'sales', 'finance'];
    }

    /** SEO parametrlərinə icazəsi varmı? (admin, seo) */
    function canAccessSeo() {
      return isStaff() && staffDoc().data.role in ['admin', 'seo'];
    }

    // ═══════════════════════════════════════════
    //  Kontent kolleksiyaları
    // ═══════════════════════════════════════════

    /** Məqalələr — hamı dərc olunmuşları oxuyur, yalnız staff yazır */
    match /articles/{articleId} {
      // Hamı published məqalələri oxuya bilər, staff hamısını görə bilər
      allow read: if resource.data.status == 'published' || isStaff();
      // Yaratmaq / yeniləmək: həm köhnə, həm yeni kateqoriya üzrə səlahiyyət lazımdır
      allow create: if canWriteArticle(request.resource.data.category);
      allow update: if canWriteArticle(resource.data.category)
                    && canWriteArticle(request.resource.data.category);
      // Silmək yalnız admin üçün
      allow delete: if isAdmin();
    }

    /**
     * Analytics kolleksiyaları - tracking üçün açıq amma validate edilir
     * Rate limiting və data validation tətbiq olunur
     */
    // Baxış sayğacı (src/lib/analytics/track-views.ts) anonim işləyir.
    // Yalnız +1 artım və məlum sahələr qəbul olunur — sayğacı şişirtmək olmaz.
    match /analytics_daily/{docId} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(
                         ['articleId', 'slug', 'category', 'date', 'views', 'uniqueVisitors', 'updatedAt'])
                    && request.resource.data.date is string
                    && request.resource.data.views == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['views', 'uniqueVisitors', 'updatedAt', 'devices', 'sources'])
                    && request.resource.data.get('views', 0) <= resource.data.get('views', 0) + 1
                    && request.resource.data.get('uniqueVisitors', 0) <= resource.data.get('uniqueVisitors', 0) + 1
                    // Cihaz və trafik mənbəyi xəritələri (yalnız məlum açarlar)
                    && request.resource.data.get('devices', {}).keys().hasOnly(['desktop', 'mobile', 'tablet'])
                    && request.resource.data.get('sources', {}).keys().hasOnly(['organic', 'social', 'direct', 'referral']);
      allow delete: if false;
    }

    match /analytics_totals/{docId} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(
                         ['articleId', 'slug', 'category', 'totalViews', 'lastViewed', 'updatedAt'])
                    && request.resource.data.totalViews == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['totalViews', 'lastViewed', 'updatedAt', 'slug', 'category'])
                    && request.resource.data.totalViews <= resource.data.get('totalViews', 0) + 1;
      allow delete: if false;
    }

    // Unikal ziyarətçi qeydi: yalnız yaradılır (mövcuddursa yazma rədd edilir = artıq sayılıb)
    match /analytics_visitors/{docId} {
      allow read: if isStaff();
      allow create: if request.resource.data.keys().hasOnly(['articleId', 'visitorId', 'date', 'timestamp'])
                    && request.resource.data.visitorId is string
                    && request.resource.data.visitorId.size() < 100;
      allow update, delete: if false;
    }

    /** Bürc şərhləri — hamı oxuya bilər, yalnız staff yazır */
    match /horoscopes/{sign} {
      allow read:  if true;
      // Yalnız staff üzvləri (müəlliflər) yaza bilər
      allow write: if isStaff();
    }

    /** E-jurnallar — hamı dərc olunmuşları görür */
    match /ejournals/{ejournalId} {
      allow read:   if resource.data.status == 'published' || isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════
    //  Reklam kolleksiyaları
    // ═══════════════════════════════════════════

    /** Reklam bannerləri — hamı oxuya bilər, yalnız admin yazır */
    match /banners/{bannerId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /** Təkmilləşdirilmiş reklam banner sistemi */
    match /advancedBanners/{bannerId} {
      // Hamı oxuya bilər (aktiv bannerləri göstərmək üçün)
      allow read:  if true;
      // Yalnız admin yazır
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        // Anonim oxucu yalnız göstərilmə/klik sayğacını +1 artıra bilər (/api/banner-impression, /api/banner-click)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['impressions'])
            && request.resource.data.impressions == resource.data.impressions + 1)
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks'])
            && request.resource.data.clicks == resource.data.clicks + 1);
    }

    /** E-kitab bannerləri */
    match /ebookBanners/{bannerId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════
    //  İstifadəçilər
    // ═══════════════════════════════════════════

    /** Redaksiya heyəti — yalnız staff oxuya bilər, yalnız admin yazır */
    match /staff/{memberEmail} {
      // Yalnız daxil olan staff üzvləri siyahını görə bilər
      allow read: if isStaff();
      // Yalnız admin yeni staff əlavə edə və ya dəyişdirə bilər
      allow create, update: if isAdmin();
      // Silmək yalnız admin üçün
      allow delete: if isAdmin();
    }

    // ═══════════════════════════════════════════
    //  İctimai formalar
    // ═══════════════════════════════════════════

    /** Məktub abunəliyi — hər kəs abunə ola bilər */
    match /subscribers/{subscriberId} {
      allow create: if request.resource.data.email is string
                    && request.resource.data.email.size() < 200;
      allow read, update: if isStaff();
      allow delete:       if isAdmin();
    }

    /** Əlaqə mesajları — hər kəs göndərə bilər */
    match /messages/{messageId} {
      allow create: if request.resource.data.message is string
                    && request.resource.data.message.size() < 5000;
      allow read, update: if isStaff();
      allow delete:       if isAdmin();
    }

    // ═══════════════════════════════════════════
    //  CRM & Biznes
    // ═══════════════════════════════════════════

    /** CRM müştərilər — yalnız CRM icazəli rollara açıq */
    match /crmClients/{clientId} {
      allow read, create, update: if canAccessCrm();
      allow delete:               if isAdmin();
    }

    /** CRM aktivliklər */
    match /crmActivities/{activityId} {
      allow read, create, update: if canAccessCrm();
      allow delete:               if canAccessCrm();
    }

    /** Reklam sifarişləri */
    match /adOrders/{orderId} {
      allow read, create, update: if canAccessCrm();
      allow delete:               if isAdmin();
    }

    /** Kontent planı — bütün staff üzvləri */
    // Redaktorun xüsusi üslubları (Word «Styles») — bütün redaksiya üçün ortaq
    match /editorStyles/{styleId} {
      allow read, write: if isStaff();
    }

    match /contentPlan/{itemId} {
      allow read, create, update, delete: if isStaff();
    }

    // ═══════════════════════════════════════════
    //  SEO & Sayt Parametrləri
    // ═══════════════════════════════════════════

    /** SEO yönləndirmələri — sayt tərəfindən oxunur */
    match /seoRedirects/{redirectId} {
      allow read:           if true;
      allow create, update: if canAccessSeo();
      allow delete:         if isAdmin();
    }

    /** SEO parametrləri — tək sənəd */
    match /seoSettings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    /** Sayt parametrləri — tək sənəd */
    match /siteSettings/{docId} {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // ═══════════════════════════════════════════
    //  Sistem & Tarixçə
    // ═══════════════════════════════════════════

    /**
     * Audit jurnalı — IMMUTABLE
     * Qeydlər yalnız əlavə edilə bilər, dəyişdirilə və silinə bilməz.
     */
    match /auditLogs/{logId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    /**
     * Bildirişlər
     * Read/create/update — staff; delete — yalnız admin.
     */
    match /notifications/{notifId} {
      allow read, create, update: if isStaff();
      allow delete:               if isAdmin();
    }

    /**
     * Məqalə versiyaları — IMMUTABLE
     * Snapshot-lar yalnız əlavə edilir, dəyişdirilmir.
     */
    match /articleVersions/{versionId} {
      allow read:   if isStaff();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════
    //  Analytics — Tracking və Statistika
    // ═══════════════════════════════════════════

    /**
     * Səhifə baxışları — hamı yaza bilər (tracking üçün),
     * yalnız staff oxuya bilər.
     */
    match /pageViews/{viewId} {
      allow read:   if isStaff();
      allow create: if true;  // Client-side tracking üçün açıq
      allow update, delete: if false;
    }

    /**
     * Session məlumatları — hamı yaza bilər,
     * yalnız staff oxuya bilər.
     */
    match /sessions/{sessionId} {
      allow read:   if isStaff();
      allow create: if true;  // Client-side tracking üçün açıq
      allow update: if false; // kod sessiyanı yeniləmir; başqasının sessiyasını dəyişmək olmaz
      allow delete: if false;
    }

    /**
     * Məqalə analitikası — staff oxuya və yaza bilər.
     */
    match /articleAnalytics/{articleId} {
      allow read, write: if isStaff();
    }

    /**
     * Gündəlik analytics — yalnız staff.
     */
    match /dailyAnalytics/{date} {
      allow read, write: if isStaff();
    }

    /**
     * CRM analytics — CRM icazəli rollara açıq.
     */
    match /crmAnalytics/{id} {
      allow read, write: if canAccessCrm();
    }

    /**
     * Gəlir analytics — CRM icazəli rollara açıq.
     */
    match /revenueAnalytics/{period} {
      allow read, write: if canAccessCrm();
    }

    // ═══════════════════════════════════════════
    //  Admin panel bölmələri (əvvəl qaydası yox idi → hamısı rədd edilirdi)
    // ═══════════════════════════════════════════

    /** Redaksiya alətləri — bütün aktiv staff */
    match /tags/{id}                { allow read, write: if isStaff(); }
    match /enhancedCategories/{id}  { allow read, write: if isStaff(); }
    match /categoryStats/{id}       { allow read, write: if isStaff(); }
    match /mediaFolders/{id}        { allow read, write: if isStaff(); }
    match /mediaFiles/{id}          { allow read, write: if isStaff(); }
    match /articleTranslations/{id} { allow read, write: if isStaff(); }
    match /translationJobs/{id}     { allow read, write: if isStaff(); }
    match /pagePerformance/{id}     { allow read, write: if isStaff(); }
    match /optimizationTips/{id}    { allow read, write: if isStaff(); }

    /** Şərhlər — saytda hələ şərh forması yoxdur; yalnız redaksiya idarə edir */
    match /comments/{id} {
      allow read, create, update: if isStaff();
      allow delete:               if isAdmin()
                                    || (isStaff() && staffDoc().data.role == 'moderator');
    }

    /** Silmə sorğuları — staff yaradır, admin təsdiqləyir */
    match /deletionRequests/{id} {
      allow read, create: if isStaff();
      allow update, delete: if isAdmin();
    }

    /** E-jurnal yaradıcısının layout-u — yalnız redaksiya */
    match /ejournalLayouts/{id} { allow read, write: if isStaff(); }

    /** Çap nəşrləri — oxucu yalnız dərc olunmuşları görür; redaksiya idarə edir */
    match /printEditions/{id} {
      allow read: if resource.data.status == 'published' || isStaff();
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    /** E-jurnal satışı və yükləmələr — satış/maliyyə */
    match /ejournalOrders/{id}    { allow read, write: if canAccessCrm(); }
    match /ejournalDownloads/{id} { allow read, write: if canAccessCrm(); }

    /** Üzvlük planları, istifadəçilər, push, backup — yalnız admin */
    match /subscriptionPlans/{id}    { allow read, write: if isAdmin(); }
    match /userSubscriptions/{id}    { allow read, write: if isAdmin(); }
    match /subscriptionPayments/{id} { allow read, write: if isAdmin(); }
    match /pushCampaigns/{id}        { allow read, write: if isAdmin(); }
    match /pushTemplates/{id}        { allow read, write: if isAdmin(); }
    match /userFcmTokens/{id}        { allow read, write: if isAdmin(); }
    match /pushDeliveryLogs/{id}     { allow read, write: if isAdmin(); }
    match /frontendUsers/{id}        { allow read, write: if isAdmin(); }
    match /userReadingHistory/{id}   { allow read, write: if isAdmin(); }
    match /userActivities/{id}       { allow read, write: if isAdmin(); }
    match /databaseBackups/{id}      { allow read, write: if isAdmin(); }
    match /backupSchedules/{id}      { allow read, write: if isAdmin(); }
    match /restoreOperations/{id}    { allow read, write: if isAdmin(); }

    // ═══════════════════════════════════════════
    //  Ana səhifə redaksiya idarəetməsi
    // ═══════════════════════════════════════════

    /**
     * Ana səhifə editorial konfiqurasiyaları
     * Oxumaq — hamı (public homepage üçün)
     * Yazmaq — yalnız admin və editor
     */
    match /homepageEditorial/{sectionId} {
      allow read: if true;  // Public homepage rendering üçün lazımdır
      allow write: if isStaff() && staffDoc().data.role in ['admin', 'editor'];
    }

    /**
     * Ana səhifə redaksiya audit loqu — IMMUTABLE
     * Yalnız yaradılır, dəyişdirilə və silinə bilməz
     */
    match /homepageEditorialAudit/{logId} {
      allow read:   if isStaff();
      allow create: if isStaff() && staffDoc().data.role in ['admin', 'editor'];
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════
    //  Default — hər şey bağlıdır
    // ═══════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
